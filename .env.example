# -------------------------------------------------------------
# EduSathi LMS - Environment Configuration Template
# -------------------------------------------------------------

# General Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration (Supabase PostgreSQL / Direct Postgres)
# Leave blank to use built-in zero-config local database
DATABASE_URL=
DIRECT_URL=

# Supabase Credentials (optional for cloud Supabase integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication Secrets
JWT_SECRET=super_secret_jwt_signing_key_edusathi_production_random_string_2026
JWT_EXPIRES_IN=7d

# AI Study Assistant Configuration (Google Gemini or OpenAI)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
